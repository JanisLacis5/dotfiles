# Copy to ~/.config/neomutt/account and replace every example value.
# This template assumes IMAP + SMTP with TLS.

set from = "you@example.com"
set realname = "Your Name"

set imap_user = "you@example.com"
set smtp_url = "smtps://you@example.com@smtp.example.com:465/"
set folder = "imaps://imap.example.com:993/"
set spool_file = "+INBOX"
set postponed = "+Drafts"
set record = "+Sent"
set trash = "+Trash"

# Prefer a password manager. These examples require the relevant CLI.
# Escape shell-special characters correctly in your password-manager entry name.
set imap_pass = "`pass show mail/example.com | head -n1`"
set smtp_pass = "`pass show mail/example.com | head -n1`"

# Alternative using secret-tool:
# set imap_pass = "`secret-tool lookup service imap account you@example.com`"
# set smtp_pass = "`secret-tool lookup service smtp account you@example.com`"

set ssl_starttls = yes
set ssl_force_tls = yes
set imap_keepalive = 300
set imap_check_subscribed = yes
set imap_list_subscribed = yes

mailboxes +INBOX +Sent +Drafts +Trash
